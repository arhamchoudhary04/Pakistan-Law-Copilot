# ================= Knowledge Copilot — environment =================
# Copy to .env and fill in GROQ_API_KEY. Everything else has sane defaults.

# ---- Generation provider (Groq free API) ----
# Get a free key at https://console.groq.com/keys  (no billing / no card).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# ---- Embeddings provider (local, free, in-process) ----
# fastembed downloads a small model on first run (~130MB). No API key needed.
EMBED_PROVIDER=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# ---- Retrieval ----
CORPUS_DIR=data/corpus
DATA_DIR=.data
TOP_K=5
# Cosine similarity (0..1) below which the answer is refused ("I don't know").
# Tuned for bge-small-en-v1.5 (high similarity floor): on-topic Qs score ~0.78+,
# off-topic ~0.53-, so 0.65 cleanly separates them. Re-tune if you swap embed models.
RELEVANCE_THRESHOLD=0.65
CHUNK_TOKENS=600
CHUNK_OVERLAP=80

# ---- Reranking (local cross-encoder via fastembed; downloads ~90MB on first run) ----
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Candidates pulled from the vector store (per query) before reranking down to TOP_K.
RERANK_CANDIDATES=12

# ---- Agent (LangGraph) ----
# Rewrite the query for retrieval, and self-verify the answer; loop back on
# unsupported claims up to MAX_ATTEMPTS times, then finalize.
REWRITE_ENABLED=true
VERIFY_ENABLED=true
MAX_ATTEMPTS=2

# ---- Knowledge graph (Neo4j, optional) ----
# Hybrid retrieval augments vector hits with cross-referenced provisions from a
# Neo4j graph. Leave GRAPH_ENABLED=false to run vector-only (no Neo4j needed).
# Free instance: https://neo4j.com/cloud/aura-free/  (URI + username + password).
# On a normal network use neo4j+s://; use neo4j+ssc:// only if a TLS-inspecting
# proxy blocks cert verification. Aura Free's username/database may be the instance id.
GRAPH_ENABLED=false
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---- Auth & chat history (local SQLite at DATA_DIR/app.db) ----
# Secret used to sign session tokens. Generate a long random value for anything
# beyond local dev, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=dev-insecure-change-me
AUTH_TOKEN_TTL_HOURS=168

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated allowed CORS origins for the web app.
# 3001 is included because Next.js falls back to it when 3000 is already in use.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Web ----
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
